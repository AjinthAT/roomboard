# Copier en deploy/.env et remplir. Ce fichier ne contient que des valeurs factices.
# Toute la configuration passe par des variables ROOMOS__ (docs/11-conventions.md).

# Port exposé sur la VM
CORE_PORT=8080

# Base SQLite. /data est le volume docker : sans ça, la base repart de zéro
# à chaque recréation du conteneur.
ROOMOS__DatabasePath=/data/roomos.db

# --- M1 ---
# Jeton du front, saisi une fois dans l'UI puis gardé en localStorage
ROOMOS__ApiToken=change-me-front
# Jeton de l'agent Windows, à recopier dans son appsettings.json
ROOMOS__AgentToken=change-me-agent

# PC piloté. Relever la MAC de la carte Ethernet avec `getmac /v` sur le PC.
ROOMOS__Pc__Mac=AA:BB:CC:DD:EE:FF
ROOMOS__Pc__Ip=192.168.1.y
ROOMOS__Pc__Broadcast=192.168.1.255

# --- M2 ---
# Indices de correspondance des sorties audio. Ils visent le matériel, pas le rôle
# Windows : « Casque » correspondrait à « Casque pour téléphone », le canal
# communications en bande étroite du casque, pas sa voie audio principale.
# Relever les noms exacts avec : RoomOS.Agent.Windows.exe --audio
ROOMOS__AudioOutputs__0__Id=jbl
ROOMOS__AudioOutputs__0__Name=JBL
ROOMOS__AudioOutputs__0__MatchHint=JBL
ROOMOS__AudioOutputs__1__Id=headset
ROOMOS__AudioOutputs__1__Name=Casque
ROOMOS__AudioOutputs__1__MatchHint=CORSAIR

# --- M3 ---
# Client ID public (le flux PKCE n'utilise pas de secret client).
ROOMOS__Spotify__ClientId=
# Imposé par Spotify : HTTPS partout sauf IP de bouclage littérale. Ni une adresse
# LAN, ni « localhost » ne sont acceptés. Voir docs/09-integrations.md.
ROOMOS__Spotify__RedirectUri=http://127.0.0.1:8080/api/music/callback
# Nom de l'appareil Spotify correspondant au PC, relevé via GET /api/music/devices.
# Les scènes transfèrent la lecture dessus avant toute commande musicale (ADR D11).
ROOMOS__Spotify__PcDeviceHint=NOM-DU-PC

# Playlists mises en avant dans la carte Musique. Récupérer l'URI dans Spotify :
# clic droit sur la playlist > Partager > Copier le lien, puis transformer
# https://open.spotify.com/playlist/XXXX en spotify:playlist:XXXX
# ROOMOS__Spotify__Playlists__0__Name=Chill
# ROOMOS__Spotify__Playlists__0__Uri=spotify:playlist:XXXX
# ROOMOS__Spotify__Playlists__1__Name=Focus
# ROOMOS__Spotify__Playlists__1__Uri=spotify:playlist:YYYY

# --- M4 ---
# Le Core tourne en network_mode: host (nécessaire au Wake-on-LAN, voir
# docs/03-architecture.md), donc il ne résout pas les noms du réseau bridge :
# Mosquitto se joint par 127.0.0.1, pas par « mosquitto ».
ROOMOS__Mqtt__Host=127.0.0.1
ROOMOS__Mqtt__Port=1883

# --- M6 ---
# Mot de passe de l'administrateur Grafana, sur http://192.168.1.x:3000
GRAFANA_PASSWORD=change-me
