# Copier en deploy/.env et remplir. Ce fichier ne contient que des valeurs factices.
# Toute la configuration passe par des variables ROOMOS__ (docs/11-conventions.md).

# Port exposé sur la VM
CORE_PORT=8080

# Base SQLite. /data est le volume docker : sans ça, la base repart de zéro
# à chaque recréation du conteneur.
ROOMOS__DatabasePath=/data/roomos.db

# --- M1 ---
# Jeton du front, saisi une fois dans l'UI puis gardé en localStorage
ROOMOS__ApiToken=change-me-front
# Jeton de l'agent Windows, à recopier dans son appsettings.json
ROOMOS__AgentToken=change-me-agent

# PC piloté. Relever la MAC de la carte Ethernet avec `getmac /v` sur le PC.
ROOMOS__Pc__Mac=C8:7F:54:68:BB:40
ROOMOS__Pc__Ip=192.168.1.150
ROOMOS__Pc__Broadcast=192.168.1.255

# --- M3 ---
ROOMOS__Spotify__ClientId=
ROOMOS__Spotify__RedirectUri=http://192.168.1.30:8080/api/music/callback

# --- M4 ---
# Le Core tourne en network_mode: host (nécessaire au Wake-on-LAN, voir
# docs/03-architecture.md), donc il ne résout pas les noms du réseau bridge :
# Mosquitto se joint par 127.0.0.1, pas par « mosquitto ».
ROOMOS__Mqtt__Host=127.0.0.1
ROOMOS__Mqtt__Port=1883
